const API_URL = "http://localhost:3000";

const budgetForm = document.getElementById("budgetForm");
const expenseForm = document.getElementById("expenseForm");

const budgetList = document.getElementById("budgetList");
const expenseBudget = document.getElementById("expenseBudget");

const totalBudget = document.getElementById("totalBudget");
const totalSpent = document.getElementById("totalSpent");
const remaining = document.getElementById("remaining");
const message = document.getElementById("message");

function formatMoney(value) {
  return Number(value).toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL"
  });
}

function showMessage(text, color) {
  message.textContent = text;
  message.style.color = color;

  setTimeout(() => {
    message.textContent = "";
  }, 3000);
}

// Carregar resumo geral
async function loadSummary() {
  try {
    const response = await fetch(`${API_URL}/summary`);
    const data = await response.json();

    totalBudget.textContent = formatMoney(data.totalBudget);
    totalSpent.textContent = formatMoney(data.totalSpent);
    remaining.textContent = formatMoney(data.remaining);

  } catch (error) {
    showMessage("Erro ao carregar resumo.", "red");
  }
}

// Carregar orçamentos
async function loadBudgets() {
  try {
    const response = await fetch(`${API_URL}/budgets`);
    const budgets = await response.json();

    budgetList.innerHTML = "";
    expenseBudget.innerHTML = '<option value="">Selecione um orçamento</option>';

    if (budgets.length === 0) {
      budgetList.innerHTML = "<p>Nenhum orçamento cadastrado.</p>";
      return;
    }

    budgets.forEach((budget) => {
      // Adiciona no select do formulário de gastos
      const option = document.createElement("option");
      option.value = budget.id;
      option.textContent = budget.name;
      expenseBudget.appendChild(option);

      // Cria card do orçamento
      const card = document.createElement("div");
      card.className = "budget-card";

      if (budget.color === "red") {
        card.classList.add("red");
      }

      let expensesHTML = "";

      budget.expenses.forEach((expense) => {
        expensesHTML += `
          <div class="expense">
            <span>
              ${expense.description} - ${formatMoney(expense.amount)}
            </span>

            <button class="delete-btn" onclick="deleteExpense(${expense.id})">
              Excluir
            </button>
          </div>
        `;
      });

      card.innerHTML = `
        <h3>${budget.name}</h3>

        <p><strong>Valor:</strong> ${formatMoney(budget.amount)}</p>
        <p><strong>Gasto:</strong> ${formatMoney(budget.totalSpent)}</p>
        <p><strong>Restante:</strong> ${formatMoney(budget.remaining)}</p>
        <p><strong>Status:</strong> ${budget.message}</p>

        <button class="delete-btn" onclick="deleteBudget(${budget.id})">
          Excluir Orçamento
        </button>

        <h4 style="margin-top: 15px;">Gastos</h4>
        ${expensesHTML || "<p>Nenhum gasto cadastrado.</p>"}
      `;

      budgetList.appendChild(card);
    });

  } catch (error) {
    showMessage("Erro ao carregar orçamentos.", "red");
  }
}

// Criar orçamento
budgetForm.addEventListener("submit", async function(event) {
  event.preventDefault();

  const name = document.getElementById("budgetName").value;
  const amount = document.getElementById("budgetAmount").value;

  try {
    const response = await fetch(`${API_URL}/budgets`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        name: name,
        amount: Number(amount)
      })
    });

    const data = await response.json();

    if (!response.ok) {
      showMessage(data.error, "red");
      return;
    }

    budgetForm.reset();
    showMessage("Orçamento cadastrado com sucesso!", "green");
    loadAll();

  } catch (error) {
    showMessage("Erro ao conectar com a API.", "red");
  }
});

// Criar gasto
expenseForm.addEventListener("submit", async function(event) {
  event.preventDefault();

  const budgetId = document.getElementById("expenseBudget").value;
  const description = document.getElementById("expenseDescription").value;
  const category = document.getElementById("expenseCategory").value || "Sem categoria";
  const amount = document.getElementById("expenseAmount").value;

  try {
    const response = await fetch(`${API_URL}/expenses`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        budgetId: Number(budgetId),
        description: description,
        category: category,
        amount: Number(amount)
      })
    });

    const data = await response.json();

    if (!response.ok) {
      showMessage(data.error, "red");
      return;
    }

    expenseForm.reset();
    showMessage("Gasto cadastrado com sucesso!", "green");
    loadAll();

  } catch (error) {
    showMessage("Erro ao conectar com a API.", "red");
  }
});

// Excluir orçamento
async function deleteBudget(id) {
  try {
    await fetch(`${API_URL}/budgets/${id}`, {
      method: "DELETE"
    });

    showMessage("Orçamento excluído.", "green");
    loadAll();

  } catch (error) {
    showMessage("Erro ao excluir orçamento.", "red");
  }
}

// Excluir gasto
async function deleteExpense(id) {
  try {
    await fetch(`${API_URL}/expenses/${id}`, {
      method: "DELETE"
    });

    showMessage("Gasto excluído.", "green");
    loadAll();

  } catch (error) {
    showMessage("Erro ao excluir gasto.", "red");
  }
}

// Carrega tudo
function loadAll() {
  loadSummary();
  loadBudgets();
}

loadAll();